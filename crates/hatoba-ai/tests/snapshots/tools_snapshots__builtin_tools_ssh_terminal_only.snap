---
source: crates/hatoba-ai/tests/tools_snapshots.rs
expression: builtin_tools(&terminal_only)
---
[
  {
    "name": "read_terminal",
    "description": "Read the terminal tab's last `lines` lines, counted back from the last line with text across the visible screen and the scrollback, as plain text with soft-wrapped lines joined, with how many lines the terminal has in all and whether the alternate screen (vim, htop, less and so on) is active. Use it to see the prompt, earlier output or a full-screen program. With wait_seconds, it first waits until new output has come and been quiet for 1 second, or wait_seconds has passed, so it can wait for a command that is still running. It runs without asking.",
    "input_schema": {
      "properties": {
        "lines": {
          "description": "How many lines to return, counted back from the last line with text (at most 1000). Without it: 20, or the whole screen while the alternate screen is active.",
          "type": "integer"
        },
        "wait_seconds": {
          "description": "Longest wait for new output before reading (at most 120). Without it, the screen is read at once.",
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "run_command",
    "description": "Run a shell command on a new exec channel of the tab's SSH connection and return its stdout, stderr and exit status. The channel has no PTY, so interactive programs and password prompts do not work, and it does not share the terminal shell's working directory, environment variables or sudo session: it starts in the user's home directory, or in `workdir` when given. Its output does not appear in the terminal. The command is stopped after timeout_seconds (default 120, at most 600). Output longer than 30,000 characters keeps its first 7,500 and last 22,500 characters.",
    "input_schema": {
      "properties": {
        "command": {
          "description": "The command line, run by the user's login shell on the host.",
          "type": "string"
        },
        "timeout_seconds": {
          "description": "Seconds before the command is stopped (default 120, at most 600).",
          "type": "integer"
        },
        "workdir": {
          "description": "The directory to run the command in: an absolute path, or a path from the user's home directory (default: the home directory). Use it rather than starting the command with cd, except on a host without sh, such as a Windows server, which does not take it.",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  },
  {
    "name": "send_input",
    "description": "Type text into the terminal tab's shell, the same way the keyboard does, then press `keys` in order. The text is sent as it is, without a newline: to run a command, send its text with keys [\"enter\"]. Keys work in full-screen programs too: [\"ctrl+x\", \"n\"] leaves nano without saving. Then wait until the output has been quiet for 1 second or wait_seconds has passed (default 10, at most 120), and return the output that appeared after the input, or the whole screen when a full-screen program is active. A quiet second does not mean a command has finished, since many commands pause while they work: to wait for more output, call read_terminal with wait_seconds. The text goes to the shell itself, so commands use its working directory, environment and sudo session, and can be interactive or ask for input. A command started this way keeps running in the shell when the turn stops.",
    "input_schema": {
      "properties": {
        "keys": {
          "description": "Keys to press in order after the text. A key is one printable character, or a name: enter, tab, esc, up, down, left, right, home, end, page_up, page_down, insert, delete, backspace, space, f1 to f12, shift+tab, ctrl+a to ctrl+z, or alt+ and a character (alt+f, alt++).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "Text to type, sent as it is (may be empty to press only keys).",
          "type": "string"
        },
        "wait_seconds": {
          "description": "Longest wait for the output to settle (default 10, at most 120).",
          "type": "integer"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  {
    "name": "read_file",
    "description": "Read a text file on the tab's host. Returns its lines numbered like `cat -n`, from line `offset` (default 1), at most `limit` lines and 30,000 characters, with the file's line count and the offset to read on from; lines longer than 2,000 characters are cut. It runs on a separate exec channel, so a relative path or `~/` starts at the user's home directory, not at the shell's working directory. Binary files and anything but regular files are refused. A file over 1 MB is read a page at a time like any other, but edit_file and write_file do not change it. It runs without asking, and without sudo; when permission is denied, use send_input with sudo in the terminal instead.",
    "input_schema": {
      "properties": {
        "limit": {
          "description": "The most lines to return (default: as many as fit in 30,000 characters).",
          "type": "integer"
        },
        "offset": {
          "description": "The line number to start from (default 1).",
          "type": "integer"
        },
        "path": {
          "description": "The file's absolute path, or a path from the user's home directory.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  {
    "name": "edit_file",
    "description": "Edit a text file on the tab's host: replace old_string with new_string and write the file back in place, so its owner, mode and links stay. It is refused unless you read the file with read_file in this conversation and it has not changed since. old_string must match the file exactly, including indentation and line breaks, and appear exactly once unless replace_all is true: copy it from read_file's output without the line numbers. Line breaks follow the file's style (CRLF or LF) on their own. It runs without sudo; when permission is denied, use send_input with sudo in the terminal instead. Files over 1 MB and binary files are refused. The result shows the changed lines.",
    "input_schema": {
      "properties": {
        "new_string": {
          "description": "The text to put in its place; empty to delete old_string.",
          "type": "string"
        },
        "old_string": {
          "description": "The exact text to replace.",
          "type": "string"
        },
        "path": {
          "description": "The file's absolute path, or a path from the user's home directory.",
          "type": "string"
        },
        "replace_all": {
          "description": "Replace every occurrence instead of exactly one (default false).",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "old_string",
        "new_string"
      ],
      "type": "object"
    }
  },
  {
    "name": "write_file",
    "description": "Create a text file on the tab's host, or replace all of its content. An existing file is rewritten in place, so its owner, mode and links stay, and it keeps CRLF line breaks if it has them. Replacing an existing file is refused unless you read it with read_file in this conversation and it has not changed since; creating a file needs no read. The directory must exist already. Use edit_file to change part of an existing file. It runs without sudo; when permission is denied, use send_input with sudo in the terminal instead. Content over 1 MB is refused.",
    "input_schema": {
      "properties": {
        "content": {
          "description": "The whole content of the file.",
          "type": "string"
        },
        "path": {
          "description": "The file's absolute path, or a path from the user's home directory.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "type": "object"
    }
  },
  {
    "name": "grep",
    "description": "Search text files on the tab's host for lines that match a regular expression, on a separate exec channel: with rg where the host has it, and with find and grep -E otherwise. `path` is a file, or a directory searched with its subdirectories; a relative path or `~/` starts at the user's home directory. `pattern` is a regular expression as rg reads it (Rust regex syntax), so literal braces need a backslash, as in interface\\{\\}; for grep -E, Hatoba translates it. `multiline` lets a match span lines, with . matching line breaks, as in struct \\{[\\s\\S]*?field; it needs rg, and so do Unicode classes such as \\p{L} and inline flags other than a leading (?i). `glob` limits a directory's search to the files glob would find; a file given as `path` is searched whatever its name, as with rg. output_mode files_with_matches (the default) returns the paths of the files with a matching line, count the number of matching lines in each, and content the lines as path:line:text, with lines of context as path-line-text: `before_context` lines before each matching line, `after_context` after, `context` both. Results are sorted by path, at most `limit` entries (files, or lines for content; default 250, 0 for no limit) from `offset` (default 0) and 30,000 characters; lines are cut at 500 characters. Binary files and .git are skipped, and so are /proc, /sys, /dev and /run when it searches /. It runs without asking, and without sudo. A search stops after 30 seconds.",
    "input_schema": {
      "properties": {
        "after_context": {
          "description": "Lines to show after each matching line in content mode, in place of context's (at most 100).",
          "type": "integer"
        },
        "before_context": {
          "description": "Lines to show before each matching line in content mode, in place of context's (at most 100).",
          "type": "integer"
        },
        "context": {
          "description": "Lines to show before and after each matching line in content mode (default 0, at most 100).",
          "type": "integer"
        },
        "glob": {
          "description": "Search only the files that match this glob, such as *.conf or *.{yml,yaml}.",
          "type": "string"
        },
        "ignore_case": {
          "description": "Match regardless of letter case (default false).",
          "type": "boolean"
        },
        "limit": {
          "description": "The most entries to return (default 250; 0 for no limit).",
          "type": "integer"
        },
        "multiline": {
          "description": "Let a match span lines, with . matching line breaks (default false). Needs rg on the host.",
          "type": "boolean"
        },
        "offset": {
          "description": "Entries to skip, to read on from an earlier result (default 0).",
          "type": "integer"
        },
        "output_mode": {
          "description": "What to return (default files_with_matches).",
          "enum": [
            "files_with_matches",
            "count",
            "content"
          ],
          "type": "string"
        },
        "path": {
          "description": "The file or directory to search: an absolute path, or a path from the user's home directory (default: the home directory).",
          "type": "string"
        },
        "pattern": {
          "description": "The regular expression to search for, as rg reads it.",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    }
  },
  {
    "name": "glob",
    "description": "Find files on the tab's host by a glob pattern, with find on a separate exec channel. A pattern without / matches file names at any depth below `path`, such as *.conf; one with / matches paths from `path` on, such as sites-enabled/* or **/conf.d/*.conf; one that starts with / matches absolute paths whatever `path` is, such as /etc/nginx/**/*.conf. * and ? match within a name, ** any number of directories, [abc] one of the characters and {a,b} either alternative. `path` is the directory to search; a relative path or `~/` starts at the user's home directory. Returns the paths of the files and links to files that match, sorted by path, at most 1,000. .git directories are skipped, and so are /proc, /sys, /dev and /run when it searches /. It runs without asking, and without sudo. A search stops after 30 seconds.",
    "input_schema": {
      "properties": {
        "path": {
          "description": "The directory to search: an absolute path, or a path from the user's home directory (default: the home directory).",
          "type": "string"
        },
        "pattern": {
          "description": "The glob to match, such as **/*.conf.",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    }
  },
  {
    "name": "fetch_url",
    "description": "Fetch an http or https URL with GET, without cookies or credentials, following at most 5 redirects on the same host (a redirect to another host is returned instead: fetch that URL with a new call), and return up to 30,000 characters of its content starting at `offset` (default 0), with the total length. HTML is converted to Markdown: the page's main content without navigation, sidebars and footers, or the whole page with `full_page`. To read on, call it again with the offset the result names. Only text, HTML, JSON and XML are returned, and addresses on loopback, private or link-local networks are refused. Keep passwords, keys and tokens out of the URL.",
    "input_schema": {
      "properties": {
        "full_page": {
          "description": "Return the whole HTML page instead of its main content (default false), such as when the main content looks incomplete or you need the page's navigation.",
          "type": "boolean"
        },
        "offset": {
          "description": "Character offset to start from (default 0).",
          "type": "integer"
        },
        "url": {
          "description": "The http or https URL to fetch.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  }
]
