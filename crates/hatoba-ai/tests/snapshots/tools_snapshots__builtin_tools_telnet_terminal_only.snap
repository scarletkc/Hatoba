---
source: crates/hatoba-ai/tests/tools_snapshots.rs
expression: builtin_tools(&terminal_only)
---
[
  {
    "name": "read_terminal",
    "description": "Read the terminal tab's last `lines` lines, counted back from the last line with text across the visible screen and the scrollback, as plain text with soft-wrapped lines joined, with how many lines the terminal has in all and whether the alternate screen (vim, htop, less and so on) is active. Use it to see the prompt, earlier output or a full-screen program. With wait_seconds, it first waits until new output has come and been quiet for 1 second, or wait_seconds has passed, so it can wait for a command that is still running. It runs without asking.",
    "input_schema": {
      "properties": {
        "lines": {
          "description": "How many lines to return, counted back from the last line with text (at most 1000). Without it: 20, or the whole screen while the alternate screen is active.",
          "type": "integer"
        },
        "wait_seconds": {
          "description": "Longest wait for new output before reading (at most 120). Without it, the screen is read at once.",
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "send_input",
    "description": "Type text into the terminal tab, the same way the keyboard does, then press `keys` in order. The text is sent as it is, without a newline: to run a command, send its text with keys [\"enter\"]. Keys work in full-screen programs too: [\"ctrl+x\", \"n\"] leaves nano without saving. Then wait until the output has been quiet for 1 second or wait_seconds has passed (default 10, at most 120), and return the output that appeared after the input, or the whole screen when a full-screen program is active. A quiet second does not mean a command has finished, since many commands pause while they work: to wait for more output, call read_terminal with wait_seconds. The text goes to the device's command line, as the user's typing does, and can answer its prompts.",
    "input_schema": {
      "properties": {
        "keys": {
          "description": "Keys to press in order after the text. A key is one printable character, or a name: enter, tab, esc, up, down, left, right, home, end, page_up, page_down, insert, delete, backspace, space, f1 to f12, shift+tab, ctrl+a to ctrl+z, or alt+ and a character (alt+f, alt++).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "Text to type, sent as it is (may be empty to press only keys).",
          "type": "string"
        },
        "wait_seconds": {
          "description": "Longest wait for the output to settle (default 10, at most 120).",
          "type": "integer"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  {
    "name": "fetch_url",
    "description": "Fetch an http or https URL with GET, without cookies or credentials, following at most 5 redirects on the same host (a redirect to another host is returned instead: fetch that URL with a new call), and return up to 30,000 characters of its content starting at `offset` (default 0), with the total length. HTML is converted to Markdown: the page's main content without navigation, sidebars and footers, or the whole page with `full_page`. To read on, call it again with the offset the result names. Only text, HTML, JSON and XML are returned, and addresses on loopback, private or link-local networks are refused. Keep passwords, keys and tokens out of the URL.",
    "input_schema": {
      "properties": {
        "full_page": {
          "description": "Return the whole HTML page instead of its main content (default false), such as when the main content looks incomplete or you need the page's navigation.",
          "type": "boolean"
        },
        "offset": {
          "description": "Character offset to start from (default 0).",
          "type": "integer"
        },
        "url": {
          "description": "The http or https URL to fetch.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  }
]
