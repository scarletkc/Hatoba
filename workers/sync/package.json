{
  "name": "@hatoba/sync-worker",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end encrypted sync Worker for Hatoba (Cloudflare Workers + D1)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261007.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Replace the example value with a long random string, for example from `openssl rand -base64 32`, and save it in your password manager. Hatoba asks for it once, when the first device sets up sync."
      }
    }
  }
}
