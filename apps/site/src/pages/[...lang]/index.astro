---
import Button from "../../components/Button.astro";
import DownloadButton from "../../components/DownloadButton.astro";
import Icon from "../../components/Icon.astro";
import NightBand from "../../components/NightBand.astro";
import RingList from "../../components/RingList.astro";
import Sea from "../../components/Sea.astro";
import Section from "../../components/Section.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Shot from "../../components/Shot.astro";
import Window from "../../components/Window.astro";
import { REPO_URL, SECURITY_MODEL_URL } from "../../consts";
import { LANG, localePath, localeStaticPaths, messages, type Locale } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { demoBuilt } from "../../lib/demo";
import { loadRelease } from "../../lib/release";
import { screenshot } from "../../lib/screenshots";
import { pageTitle, softwareApplication } from "../../lib/seo";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = messages(locale);
const release = await loadRelease();
const hero = screenshot(locale, "ai-assistant");
/** The app's demo in the page's language, when scripts/demo.mjs built it. */
const demo = demoBuilt() ? `/demo/?lang=${LANG[locale]}` : null;

/** The AI panel down to the approval card, and the deployment dialog, in screenshot pixels. */
const AI_PANEL = { x: 2002, y: 172, w: 878, h: 1200 };
const DEPLOY_DIALOG = { x: 1094, y: 400, w: 1152, h: 1090 };
---

<Base locale={locale} title={pageTitle(locale)} description={t.meta.description} path="/" jsonLd={softwareApplication(locale, release)} heroHeader>
  <NightBand class="hero">
    <div class="container intro">
      <h1 class="wordmark wide">Hatoba</h1>
      <p class="lead">{t.meta.description}</p>
      <div class="actions">
        <DownloadButton locale={locale} release={release} />
        <Button variant="outline" href={REPO_URL} icon="github" iconSize={20}>{t.hero.github}</Button>
      </div>
      <p class="available"><a href={localePath(locale, "/download/")}>{t.hero.available(release.version)}</a></p>
    </div>
    <div class="horizon" data-demo={demo} data-demo-title={t.demo.title} style={`--ratio: ${hero.height / hero.width}`}>
      <div class="stage">
        {
          demo && (
            <div class="demo-bar" hidden>
              <p>{t.demo.note}</p>
              <div class="demo-actions">
                <Button variant="night" size="sm" icon="restart" data-demo-restart>
                  {t.demo.restart}
                </Button>
                <Button variant="night" size="sm" icon="external" href={demo} target="_blank" rel="noopener">
                  {t.demo.newTab}
                </Button>
                <Button variant="night" size="sm" icon="close" data-demo-close>
                  {t.demo.close}
                </Button>
              </div>
            </div>
          )
        }
        <Window class="rise">
          <Shot src={hero} alt={t.hero.alt} width="min(1100px, 100vw - 48px)" eager />
          {
            demo && (
              <Button variant="pier" class="try" data-demo-open hidden>
                <span class="try-icon">
                  <Icon name="play" />
                </span>
                {t.demo.try}
              </Button>
            )
          }
        </Window>
      </div>
      <Sea depth="var(--sea-depth)" />
    </div>
  </NightBand>

  <Section id="features" class="split">
    <div class="text">
      <SectionHeader title={t.ai.title} lead={t.ai.body} />
      <RingList items={t.ai.points} />
    </div>
    <div class="media">
      <Window class="panel">
        <Shot src={screenshot(locale, "ai-approval")} alt={t.ai.alt} width="min(420px, 100vw - 32px)" crop={AI_PANEL} />
      </Window>
    </div>
  </Section>

  <Section continues class="split reverse">
    <div class="text">
      <SectionHeader title={t.sync.title} lead={t.sync.body} />
      <RingList items={t.sync.points} />
    </div>
    <div class="media">
      <Window class="dialog">
        <Shot src={screenshot(locale, "sync-deploy")} alt={t.sync.alt} width="min(560px, 100vw - 32px)" crop={DEPLOY_DIALOG} />
      </Window>
    </div>
  </Section>

  <Section tone="mist" class="essentials">
    <SectionHeader title={t.essentials.title} />
    <Window>
      <Shot src={screenshot(locale, "dashboard")} alt={t.essentials.alt} width="min(1180px, 100vw - 32px)" />
    </Window>
    <dl>
      {
        t.essentials.items.map((item) => (
          <div>
            <dt>{item.term}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section class="columns">
    <SectionHeader title={t.security.title} />
    <div class="text">
      <p>{t.security.body}</p>
      <p>{t.security.openSource}</p>
      <p><a href={SECURITY_MODEL_URL} hreflang="en">{t.security.link}</a></p>
    </div>
  </Section>

  <NightBand sea="40px" class="cta">
    <div class="container">
      <SectionHeader as="h2" size="h1" align="center" title={t.cta.title} lead={t.cta.body} />
      <div class="actions">
        <DownloadButton locale={locale} release={release} />
        <Button variant="outline" href={localePath(locale, "/download/")}>{t.hero.allDownloads}</Button>
      </div>
    </div>
  </NightBand>
</Base>

<script>
  // The demo takes the screenshot's place in its window once it has loaded, and the window rises out
  // of the water so that none of the app is under it. The screenshot opens it too, where the button
  // shows.
  for (const horizon of document.querySelectorAll<HTMLElement>(".horizon[data-demo]")) {
    const open = horizon.querySelector<HTMLButtonElement>("[data-demo-open]")!;
    const bar = horizon.querySelector<HTMLElement>(".demo-bar")!;
    const shot = horizon.querySelector<HTMLElement>(".window")!;
    let frame: HTMLIFrameElement | null = null;
    const start = () => {
      if (frame || getComputedStyle(open).display === "none") return;
      frame = document.createElement("iframe");
      frame.src = horizon.dataset.demo!;
      frame.title = horizon.dataset.demoTitle!;
      frame.addEventListener(
        "load",
        () => {
          horizon.classList.replace("loading", "open");
          bar.hidden = false;
          const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          horizon.querySelector(".stage")!.scrollIntoView({ block: "center", behavior: still ? "auto" : "smooth" });
          frame?.focus();
        },
        { once: true },
      );
      horizon.classList.add("loading");
      open.setAttribute("aria-busy", "true");
      shot.append(frame);
    };
    horizon.classList.add("playable");
    open.hidden = false;
    shot.addEventListener("click", start);
    bar.querySelector("[data-demo-restart]")!.addEventListener("click", () => {
      frame?.contentWindow?.location.reload();
      frame?.focus();
    });
    bar.querySelector("[data-demo-close]")!.addEventListener("click", () => {
      frame?.remove();
      frame = null;
      horizon.classList.remove("open");
      open.removeAttribute("aria-busy");
      bar.hidden = true;
      open.focus();
    });
  }
</script>

<style>
  /* The hero: the name over the night sky, and the app standing in the sea like the pier of the icon. */
  :global(.hero) {
    overflow: hidden;
    padding-top: var(--space-page-top);
  }

  .intro {
    text-align: center;
  }

  .wordmark {
    font-size: var(--text-wordmark);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  .lead {
    max-width: 34em;
    margin: var(--space-32) auto 0;
    font-size: var(--text-lead);
    line-height: var(--leading-snug);
    color: var(--on-night-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    justify-content: center;
    margin-top: var(--space-40);
  }

  .available {
    margin-top: var(--space-16);
    font-size: var(--text-sm);
  }

  .available a {
    color: var(--on-night-2);
  }

  /* The water under the window is the horizon's bottom padding, which the sea fills. */
  .horizon {
    --shot: min(1100px, 100vw - 2 * var(--gutter));
    position: relative;
    --water: 72px;
    /* How much of the window stands in the water, as a share of its width. */
    --sink: 0.14;
    --sea-depth: calc(var(--shot) * var(--sink) + var(--water));
    margin-top: var(--space-page-top);
    padding-bottom: var(--water);
    transition:
      --sea-depth var(--duration-scene) var(--ease-emphasized),
      margin-top var(--duration-scene) var(--ease-emphasized);
  }

  @property --sea-depth {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }

  /* The sea falls below the demo's window, whose waves stay under it, and the bar above the window
     takes most of the space over it. */
  .horizon.open {
    --sea-depth: calc(var(--water) - var(--wave-height));
    margin-top: var(--space-24);
  }

  .stage {
    width: var(--shot);
    margin: 0 auto;
  }

  .horizon :global(.window) {
    position: relative;
  }

  /* The demo fills the window over its screenshot, and shows once it has loaded. */
  .horizon :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  .open :global(iframe) {
    opacity: 1;
    pointer-events: auto;
  }

  /* A short screen keeps all of the demo in view, the bar above it included. */
  .open :global(.window) {
    height: min(var(--shot) * var(--ratio), 100svh - 96px);
  }

  .open :global(.window .shot) {
    display: none;
  }

  /* The screenshot is the demo's poster: it dims under the pointer, and a click anywhere starts it. */
  .playable:not(.open) :global(.window) {
    cursor: pointer;
  }

  .playable :global(.window)::after {
    content: "";
    position: absolute;
    inset: 0;
    background: transparent;
    pointer-events: none;
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .playable:not(.open) :global(.window:hover)::after,
  .loading :global(.window)::after {
    background: var(--scrim);
  }

  .horizon :global(.try) {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    box-shadow: var(--shadow-float);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }

  .horizon :global(.window:hover .try) {
    background: var(--pier-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .horizon :global(.window:hover .try) {
      transform: translate(-50%, -50%) scale(1.04);
    }
  }

  .horizon :global(.try[hidden]),
  .open :global(.try) {
    display: none;
  }

  .try-icon {
    display: inline-flex;
  }

  /* While the demo loads, the play icon turns into a spinner. */
  .loading .try-icon {
    width: 18px;
    height: 18px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: var(--radius-full);
    animation: spin var(--duration-spin) linear infinite;
  }

  .loading .try-icon :global(svg) {
    display: none;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Above the demo: what it is, and the way out of it, since the app takes the keyboard. */
  .demo-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-24);
    margin-bottom: var(--space-12);
    font-size: var(--text-sm);
  }

  .available a {
    color: var(--on-night-2);
  }

  .demo-bar p {
    flex: 1 1 24em;
  }

  .demo-bar[hidden] {
    display: none;
  }

  .demo-actions {
    display: flex;
    flex: none;
    gap: var(--space-4);
  }

  :global(.rise) {
    animation: rise var(--duration-entrance) var(--ease-emphasized) both;
  }

  @keyframes rise {
    from {
      transform: translateY(56px);
    }
  }

  /* Features: the text beside a detail of the app. */
  :global(.split) {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-split);
    align-items: center;
  }

  :global(.reverse) .text {
    order: 2;
  }

  .text :global(.ring-list) {
    margin-top: var(--space-32);
  }

  .media {
    display: flex;
    justify-content: center;
  }

  .media :global(.panel) {
    width: min(420px, 100%);
  }

  .media :global(.dialog) {
    width: min(560px, 100%);
  }

  /* Everything else: the dashboard, then the list. */
  :global(.essentials) :global(.section-header) {
    max-width: 18em;
  }

  :global(.essentials) > :global(.window) {
    margin-top: var(--space-40);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-40) var(--space-48);
    margin: var(--space-56) 0 0;
  }

  dt {
    font-weight: 700;
    font-size: var(--text-lg);
  }

  dd {
    margin: var(--space-8) 0 0;
    color: var(--ink-2);
  }

  /* Security: a quiet statement. */
  :global(.columns) {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-split);
  }

  :global(.columns) .text {
    display: grid;
    gap: var(--space-16);
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  /* The closing call, back on the night sea. */
  :global(.cta) {
    padding-top: var(--space-section);
  }

  @media (max-width: 900px) {
    :global(.split),
    :global(.columns) {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(.reverse) .text {
      order: 0;
    }

    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The app is laid out as a desktop window, so narrower screens keep the screenshot. */
  @media (max-width: 959px) {
    .horizon :global(.try),
    .playable :global(.window)::after {
      display: none;
    }

    .playable:not(.open) :global(.window) {
      cursor: auto;
    }
  }

  @media (max-width: 600px) {
    dl {
      grid-template-columns: minmax(0, 1fr);
    }

    .horizon {
      --water: 48px;
      --sink: 0.07;
    }
  }
</style>
