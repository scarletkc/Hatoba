---
import DownloadButton from "../../components/DownloadButton.astro";
import Icon from "../../components/Icon.astro";
import Sea from "../../components/Sea.astro";
import Shot from "../../components/Shot.astro";
import { REPO_URL, SECURITY_MODEL_URL } from "../../consts";
import { LANG, localePath, localeStaticPaths, messages, type Locale } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { demoBuilt } from "../../lib/demo";
import { loadRelease } from "../../lib/release";
import { screenshot } from "../../lib/screenshots";
import { pageTitle, softwareApplication } from "../../lib/seo";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = messages(locale);
const release = await loadRelease();
const hero = screenshot(locale, "ai-assistant");
/** The app's demo in the page's language, when scripts/demo.mjs built it. */
const demo = demoBuilt() ? `/demo/?lang=${LANG[locale]}` : null;

/** The AI panel down to the approval card, and the deployment dialog, in screenshot pixels. */
const AI_PANEL = { x: 2002, y: 172, w: 878, h: 1200 };
const DEPLOY_DIALOG = { x: 1094, y: 400, w: 1152, h: 1090 };
---

<Base locale={locale} title={pageTitle(locale)} description={t.meta.description} path="/" jsonLd={softwareApplication(locale, release)} heroHeader>
  <section class="hero night">
    <div class="container intro">
      <h1 class="wordmark wide">Hatoba</h1>
      <p class="lead">{t.meta.description}</p>
      <div class="actions">
        <DownloadButton locale={locale} release={release} />
        <a class="btn btn-outline" href={REPO_URL}><Icon name="github" size={20} />{t.hero.github}</a>
      </div>
      <p class="available"><a href={localePath(locale, "/download/")}>{t.hero.available(release.version)}</a></p>
    </div>
    <div class="horizon" data-demo={demo} data-demo-title={t.demo.title} style={`--ratio: ${hero.height / hero.width}`}>
      <div class="stage">
        {
          demo && (
            <div class="demo-bar" hidden>
              <p>{t.demo.note}</p>
              <div class="demo-actions">
                <button type="button" data-demo-restart>
                  <Icon name="restart" size={16} />
                  {t.demo.restart}
                </button>
                <a href={demo} target="_blank" rel="noopener">
                  <Icon name="external" size={16} />
                  {t.demo.newTab}
                </a>
                <button type="button" data-demo-close>
                  <Icon name="close" size={16} />
                  {t.demo.close}
                </button>
              </div>
            </div>
          )
        }
        <div class="window rise">
          <Shot src={hero} alt={t.hero.alt} width="min(1100px, 100vw - 48px)" eager />
          {
            demo && (
              <button type="button" class="btn btn-pier try" data-demo-open hidden>
                <span class="try-icon"><Icon name="play" /></span>
                {t.demo.try}
              </button>
            )
          }
        </div>
      </div>
      <Sea depth="var(--sea-depth)" />
    </div>
  </section>

  <section id="features" class="feature">
    <div class="container split">
      <div class="text">
        <h2>{t.ai.title}</h2>
        <p class="body">{t.ai.body}</p>
        <ul class="points">{t.ai.points.map((point) => <li>{point}</li>)}</ul>
      </div>
      <div class="media">
        <div class="window panel">
          <Shot src={screenshot(locale, "ai-approval")} alt={t.ai.alt} width="min(420px, 100vw - 32px)" crop={AI_PANEL} />
        </div>
      </div>
    </div>
  </section>

  <section class="feature reverse">
    <div class="container split">
      <div class="text">
        <h2>{t.sync.title}</h2>
        <p class="body">{t.sync.body}</p>
        <ul class="points">{t.sync.points.map((point) => <li>{point}</li>)}</ul>
      </div>
      <div class="media">
        <div class="window dialog">
          <Shot src={screenshot(locale, "sync-deploy")} alt={t.sync.alt} width="min(560px, 100vw - 32px)" crop={DEPLOY_DIALOG} />
        </div>
      </div>
    </div>
  </section>

  <section class="essentials">
    <div class="container">
      <h2>{t.essentials.title}</h2>
      <div class="window">
        <Shot src={screenshot(locale, "dashboard")} alt={t.essentials.alt} width="min(1180px, 100vw - 32px)" />
      </div>
      <dl>
        {
          t.essentials.items.map((item) => (
            <div>
              <dt>{item.term}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="security">
    <div class="container columns">
      <h2>{t.security.title}</h2>
      <div class="text">
        <p>{t.security.body}</p>
        <p>{t.security.openSource}</p>
        <p><a href={SECURITY_MODEL_URL} hreflang="en">{t.security.link}</a></p>
      </div>
    </div>
  </section>

  <section class="cta night">
    <div class="container">
      <h2>{t.cta.title}</h2>
      <p>{t.cta.body}</p>
      <div class="actions">
        <DownloadButton locale={locale} release={release} />
        <a class="btn btn-outline" href={localePath(locale, "/download/")}>{t.hero.allDownloads}</a>
      </div>
    </div>
    <Sea depth="40px" />
  </section>
</Base>

<script>
  // The demo takes the screenshot's place in its window once it has loaded, and the window rises out
  // of the water so that none of the app is under it. The screenshot opens it too, where the button
  // shows.
  for (const horizon of document.querySelectorAll<HTMLElement>(".horizon[data-demo]")) {
    const open = horizon.querySelector<HTMLButtonElement>("[data-demo-open]")!;
    const bar = horizon.querySelector<HTMLElement>(".demo-bar")!;
    const shot = horizon.querySelector<HTMLElement>(".window")!;
    let frame: HTMLIFrameElement | null = null;
    const start = () => {
      if (frame || getComputedStyle(open).display === "none") return;
      frame = document.createElement("iframe");
      frame.src = horizon.dataset.demo!;
      frame.title = horizon.dataset.demoTitle!;
      frame.addEventListener(
        "load",
        () => {
          horizon.classList.replace("loading", "open");
          bar.hidden = false;
          const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          horizon.querySelector(".stage")!.scrollIntoView({ block: "center", behavior: still ? "auto" : "smooth" });
          frame?.focus();
        },
        { once: true },
      );
      horizon.classList.add("loading");
      open.setAttribute("aria-busy", "true");
      shot.append(frame);
    };
    horizon.classList.add("playable");
    open.hidden = false;
    shot.addEventListener("click", start);
    bar.querySelector("[data-demo-restart]")!.addEventListener("click", () => {
      frame?.contentWindow?.location.reload();
      frame?.focus();
    });
    bar.querySelector("[data-demo-close]")!.addEventListener("click", () => {
      frame?.remove();
      frame = null;
      horizon.classList.remove("open");
      open.removeAttribute("aria-busy");
      bar.hidden = true;
      open.focus();
    });
  }
</script>

<style>
  /* The hero: the name over the night sky, and the app standing in the sea like the pier of the icon. */
  .hero {
    overflow: hidden;
    padding-top: clamp(32px, 7vw, 88px);
  }

  .intro {
    text-align: center;
  }

  .wordmark {
    font-size: clamp(76px, 16vw, 184px);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  .lead {
    max-width: 34em;
    margin: 28px auto 0;
    font-size: clamp(18px, 2.1vw, 22px);
    line-height: 1.5;
    color: var(--on-night-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 36px;
  }

  .available {
    margin-top: 16px;
    font-size: 14px;
  }

  .available a {
    color: var(--on-night-2);
  }

  /* The water under the window is the horizon's bottom padding, which the sea fills. */
  .horizon {
    --shot: min(1100px, 100vw - 2 * var(--gutter));
    position: relative;
    --water: 72px;
    /* How much of the window stands in the water, as a share of its width. */
    --sink: 0.14;
    --sea-depth: calc(var(--shot) * var(--sink) + var(--water));
    margin-top: clamp(48px, 7vw, 80px);
    padding-bottom: var(--water);
    transition: --sea-depth 0.8s cubic-bezier(0.2, 0.7, 0.15, 1);
  }

  @property --sea-depth {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }

  /* The sea falls below the demo's window, whose waves (36px) stay under it, and the bar above the
     window takes most of the space over it. */
  .horizon.open {
    --sea-depth: calc(var(--water) - 36px);
    margin-top: 24px;
  }

  .stage {
    width: var(--shot);
    margin: 0 auto;
  }

  .horizon .window {
    position: relative;
  }

  /* The demo fills the window over its screenshot, and shows once it has loaded. */
  .window :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .open .window :global(iframe) {
    opacity: 1;
    pointer-events: auto;
  }

  /* A short screen keeps all of the demo in view, the bar above it included. */
  .open .window {
    height: min(var(--shot) * var(--ratio), 100svh - 96px);
  }

  .open .window :global(.shot) {
    display: none;
  }

  /* The screenshot is the demo's poster: it dims under the pointer, and a click anywhere starts it. */
  .playable:not(.open) .window {
    cursor: pointer;
  }

  .playable .window::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(9 16 39 / 0);
    pointer-events: none;
    transition: background-color 0.2s ease;
  }

  .playable:not(.open) .window:hover::after,
  .loading .window::after {
    background: rgb(9 16 39 / 0.22);
  }

  .try {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 12px 32px rgb(5 12 40 / 0.45);
    transition: background-color 0.15s ease, transform 0.2s ease;
  }

  .window:hover .try {
    background: var(--foam);
    transform: translate(-50%, -50%) scale(1.04);
  }

  .try[hidden],
  .open .try {
    display: none;
  }

  .try-icon {
    display: inline-flex;
  }

  /* While the demo loads, the play icon turns into a spinner. */
  .loading .try-icon {
    width: 18px;
    height: 18px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .loading .try-icon :global(svg) {
    display: none;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Above the demo: what it is, and the way out of it, since the app takes the keyboard. */
  .demo-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    margin-bottom: 12px;
    font-size: 14px;
    color: var(--on-night-2);
  }

  .demo-bar p {
    flex: 1 1 24em;
  }

  .demo-bar[hidden] {
    display: none;
  }

  .demo-actions {
    display: flex;
    flex: none;
    gap: 4px;
  }

  .demo-actions button,
  .demo-actions a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    color: var(--on-night);
    text-decoration: none;
    cursor: pointer;
  }

  .demo-actions button:hover,
  .demo-actions a:hover {
    background: rgb(227 238 255 / 0.12);
  }

  .rise {
    animation: rise 1.4s cubic-bezier(0.2, 0.7, 0.15, 1) 0.1s both;
  }

  @keyframes rise {
    from {
      transform: translateY(56px);
    }
  }

  /* Features: the text beside a detail of the app. */
  .feature {
    padding: clamp(72px, 10vw, 128px) 0;
  }

  .feature + .feature {
    padding-top: 0;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .reverse .text {
    order: 2;
  }

  h2 {
    font-size: clamp(30px, 4vw, 44px);
  }

  .body {
    margin-top: 20px;
    font-size: 19px;
    color: var(--ink-2);
  }

  .points {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .points li {
    position: relative;
    padding-left: 26px;
  }

  /* Each point is a ring of the seigaiha. */
  .points li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: calc(var(--body-leading) * 0.5em - 6px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 2px solid var(--sea);
  }

  .media {
    display: flex;
    justify-content: center;
  }

  .panel {
    width: min(420px, 100%);
  }

  .dialog {
    width: min(560px, 100%);
  }

  /* Everything else: the dashboard, then the list. */
  .essentials {
    padding: clamp(72px, 10vw, 128px) 0;
    background: var(--mist);
  }

  .essentials h2 {
    max-width: 18em;
  }

  .essentials .window {
    margin-top: 40px;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px 48px;
    margin: 56px 0 0;
  }

  dt {
    font-weight: 700;
    font-size: 19px;
  }

  dd {
    margin: 8px 0 0;
    color: var(--ink-2);
  }

  /* Security: a quiet statement. */
  .security {
    padding: clamp(72px, 10vw, 128px) 0;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(24px, 6vw, 88px);
  }

  .security .text {
    display: grid;
    gap: 16px;
    font-size: 18px;
    color: var(--ink-2);
  }

  /* The closing call, back on the night sea. */
  .cta {
    padding: clamp(72px, 10vw, 120px) 0 calc(76px + clamp(48px, 6vw, 72px));
    text-align: center;
    overflow: hidden;
  }

  .cta h2 {
    font-size: clamp(36px, 5.4vw, 64px);
  }

  .cta p {
    max-width: 36em;
    margin: 20px auto 0;
    color: var(--on-night-2);
  }

  @media (max-width: 900px) {
    .split,
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }

    .reverse .text {
      order: 0;
    }

    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The app is laid out as a desktop window, so narrower screens keep the screenshot. */
  @media (max-width: 959px) {
    .try,
    .playable .window::after {
      display: none;
    }

    .playable:not(.open) .window {
      cursor: auto;
    }
  }

  @media (max-width: 600px) {
    dl {
      grid-template-columns: minmax(0, 1fr);
    }

    .horizon {
      --water: 48px;
      --sink: 0.07;
    }
  }
</style>
