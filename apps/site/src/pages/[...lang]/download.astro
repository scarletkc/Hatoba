---
import Icon from "../../components/Icon.astro";
import Sea from "../../components/Sea.astro";
import { BUILD_FROM_SOURCE_URL, PACKAGE_COMMANDS, RELEASES_URL, REPO_URL } from "../../consts";
import { formatDate, formatMegabytes, localeStaticPaths, messages, type Locale } from "../../i18n";
import { installSteps } from "../../i18n/install";
import Base from "../../layouts/Base.astro";
import { inlineMarkdown } from "../../lib/markdown";
import { PLATFORMS, loadRelease } from "../../lib/release";
import { softwareApplication } from "../../lib/seo";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = messages(locale);
const release = await loadRelease();
const description =
  locale === "en" ? `${t.meta.downloadLead(release.version)} ${t.meta.description}.` : `${t.meta.downloadLead(release.version)}${t.meta.description}。`;
---

<Base
  locale={locale}
  title={`${t.meta.downloadTitle} – ${t.meta.tagline}`}
  description={description}
  path="/download/"
  jsonLd={softwareApplication(locale, release)}
  heroHeader
>
  <section class="night head">
    <div class="container">
      <h1>{t.meta.downloadTitle}</h1>
      <p class="released">
        {t.download.released(release.version, formatDate(locale, release.publishedAt))}
        <a href={release.url}>{t.download.notes}</a>
      </p>
      {
        release.preview && (
          <p class="preview">
            {t.download.preview(release.preview.version)} <a href={release.preview.url}>{t.download.previewLink}</a>
          </p>
        )
      }
    </div>
    <Sea depth="var(--head-sea)" />
  </section>

  <div class="container platforms">
    {
      PLATFORMS.map((platform) => (
        <section id={platform} class="platform" aria-labelledby={`${platform}-title`}>
          <div class="about">
            <div class="title">
              <h2 id={`${platform}-title`}>
                {t.platforms[platform]}
              </h2>
              <span class="this-device">{t.download.thisDevice}</span>
            </div>
            <p class="requirements">{t.download.requirements[platform]}</p>
          </div>
          <div class="get">
            <ul class="files">
              {release.downloads
                .filter((download) => download.platform === platform)
                .map((download) => (
                  <li class="file">
                    <a class="btn btn-deep" href={download.url}>
                      <Icon name="download" />
                      {t.download.files[download.bundle]}
                    </a>
                    <p class="name">
                      <code>{download.name}</code>
                      <span>{t.download.size(formatMegabytes(locale, download.size))}</span>
                    </p>
                    <p class="sha">
                      <span class="label">{t.download.sha256}</span>
                      <code class="hash">{download.sha256}</code>
                      <button
                        type="button"
                        class="copy"
                        data-copy={download.sha256}
                        data-copied={t.download.copied}
                        aria-label={`${t.download.copy} ${t.download.sha256}: ${download.name}`}
                      >
                        <Icon name="copy" size={16} />
                        <span class="state" data-idle={t.download.copy} data-done={t.download.copied}>
                          <span aria-live="polite">{t.download.copy}</span>
                        </span>
                      </button>
                    </p>
                  </li>
                ))}
            </ul>
            <h3>{t.download.install}</h3>
            <p class="steps" set:html={inlineMarkdown(installSteps(locale, platform, release.names))} />
            {PACKAGE_COMMANDS[platform] && (
              <>
                <h3>{t.download.packageManager}</h3>
                <p class="steps" set:html={inlineMarkdown(t.download.packages[platform])} />
                <div class="command">
                  <pre><code>{PACKAGE_COMMANDS[platform].join("\n")}</code></pre>
                  <button
                    type="button"
                    class="copy"
                    data-copy={PACKAGE_COMMANDS[platform].join("\n")}
                    data-copied={t.download.copied}
                    aria-label={`${t.download.copy}: ${PACKAGE_COMMANDS[platform].join("; ")}`}
                  >
                    <Icon name="copy" size={16} />
                    <span class="state" data-idle={t.download.copy} data-done={t.download.copied}>
                      <span aria-live="polite">{t.download.copy}</span>
                    </span>
                  </button>
                </div>
              </>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <div class="container more">
    <p>
      <a href={release.checksumsUrl}><code>SHA256SUMS.txt</code></a>
      {t.download.checksums}
    </p>
    <p>{t.download.testing} <a href={`${REPO_URL}/issues`}>{t.download.issue}</a></p>
    <ul>
      <li><a href={RELEASES_URL}>{t.download.allReleases}</a></li>
      <li><a href={BUILD_FROM_SOURCE_URL} hreflang="en">{t.download.source}</a></li>
    </ul>
  </div>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    const label = button.querySelector("[aria-live]")!;
    const idle = label.textContent;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
      } catch {
        // Without the clipboard, select the checksum or the commands so they can be copied by hand.
        const text = button.parentElement?.querySelector("code");
        if (text) getSelection()?.selectAllChildren(text);
        return;
      }
      label.textContent = button.dataset.copied!;
      setTimeout(() => (label.textContent = idle), 2000);
    });
  }
</script>

<style>
  .head {
    --head-sea: 20px;
    padding: var(--space-page-top) 0 calc(var(--head-sea) + var(--wave-height) + var(--space-above-sea));
    overflow: hidden;
  }

  h1 {
    font-size: var(--text-h1);
  }

  .released,
  .preview {
    margin-top: var(--space-16);
    color: var(--on-night-2);
    font-size: var(--text-lg);
  }

  .released a,
  .preview a {
    margin-left: var(--space-6);
  }

  /* The visitor's platform comes first. */
  .platforms {
    display: flex;
    flex-direction: column;
    padding: var(--space-24) 0;
  }

  :global(html[data-os="linux"]) #linux,
  :global(html[data-os="macos"]) #macos,
  :global(html[data-os="windows"]) #windows {
    order: -1;
  }

  .platform {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-24) var(--space-64);
    padding: var(--space-48) 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 16px;
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-12);
  }

  h2 {
    font-size: var(--text-h2);
  }

  .this-device {
    display: none;
    padding: var(--space-2) var(--space-10);
    border-radius: var(--radius-full);
    background: var(--code-bg);
    color: var(--link);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  :global(html[data-os="linux"]) #linux .this-device,
  :global(html[data-os="macos"]) #macos .this-device,
  :global(html[data-os="windows"]) #windows .this-device {
    display: inline-block;
  }

  .requirements {
    margin-top: var(--space-12);
    color: var(--ink-2);
  }

  .files {
    display: grid;
    gap: var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-12);
    align-items: baseline;
    margin-top: var(--space-12);
    font-size: var(--text-md);
    color: var(--ink-2);
  }

  .name code {
    background: none;
    padding: 0;
    color: var(--ink);
  }

  .sha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6) var(--space-10);
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }

  .hash {
    font-size: var(--text-xs);
    word-break: break-all;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 32px;
    padding: 0 var(--space-10);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .copy:hover {
    color: var(--ink);
    border-color: var(--ink-2);
  }

  /* Both labels share one cell, so the button keeps its width when "Copy" turns into "Copied". */
  .state {
    display: inline-grid;
    justify-items: center;
  }

  .state > *,
  .state::before,
  .state::after {
    grid-area: 1 / 1;
  }

  .state::before,
  .state::after {
    visibility: hidden;
  }

  .state::before {
    content: attr(data-idle);
  }

  .state::after {
    content: attr(data-done);
  }

  h3 {
    margin-top: var(--space-32);
    font-size: var(--text-body);
  }

  .steps {
    margin-top: var(--space-8);
    max-width: 44em;
  }

  .command {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-top: var(--space-12);
  }

  .command pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-md);
    background: var(--code-bg);
    overflow-x: auto;
    font-size: var(--text-sm);
  }

  .command pre code {
    background: none;
    padding: 0;
    overflow-wrap: normal;
  }

  .more {
    display: grid;
    gap: var(--space-12);
    padding: var(--space-16) 0 var(--space-96);
    color: var(--ink-2);
  }

  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 800px) {
    .platform {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
