---
import Badge from "../../components/Badge.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import DownloadFile from "../../components/DownloadFile.astro";
import Link from "../../components/Link.astro";
import NightBand from "../../components/NightBand.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { BUILD_FROM_SOURCE_URL, PACKAGE_COMMANDS, RELEASES_URL, REPO_URL } from "../../consts";
import { formatDate, localeStaticPaths, messages, type Locale } from "../../i18n";
import { installSteps } from "../../i18n/install";
import Base from "../../layouts/Base.astro";
import { inlineMarkdown } from "../../lib/markdown";
import { PLATFORMS, loadRelease } from "../../lib/release";
import { softwareApplication } from "../../lib/seo";

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const t = messages(locale);
const release = await loadRelease();
const description =
  locale === "en" ? `${t.meta.downloadLead(release.version)} ${t.meta.description}.` : `${t.meta.downloadLead(release.version)}${t.meta.description}。`;
---

<Base
  locale={locale}
  title={`${t.meta.downloadTitle} – ${t.meta.tagline}`}
  description={description}
  path="/download/"
  jsonLd={softwareApplication(locale, release)}
  heroHeader
>
  <NightBand class="head" sea="20px">
    <div class="container">
      <SectionHeader as="h1" title={t.meta.downloadTitle}>
        <p class="released">
          {t.download.released(release.version, formatDate(locale, release.publishedAt))}
          <a href={release.url}>{t.download.notes}</a>
        </p>
        {
          release.preview && (
            <p class="released">
              {t.download.preview(release.preview.version)} <a href={release.preview.url}>{t.download.previewLink}</a>
            </p>
          )
        }
      </SectionHeader>
    </div>
  </NightBand>

  <div class="container platforms">
    {
      PLATFORMS.map((platform) => (
        <section id={platform} class="platform" aria-labelledby={`${platform}-title`}>
          <div class="about">
            <div class="title">
              <h2 id={`${platform}-title`}>{t.platforms[platform]}</h2>
              <Badge class="this-device">{t.download.thisDevice}</Badge>
            </div>
            <p class="requirements">{t.download.requirements[platform]}</p>
          </div>
          <div class="get">
            <ul class="files">
              {release.downloads
                .filter((download) => download.platform === platform)
                .map((download) => (
                  <DownloadFile locale={locale} download={download} />
                ))}
            </ul>
            <h3>{t.download.install}</h3>
            <p class="steps" set:html={inlineMarkdown(installSteps(locale, platform, release.names))} />
            {PACKAGE_COMMANDS[platform] && (
              <>
                <h3>{t.download.packageManager}</h3>
                <p class="steps" set:html={inlineMarkdown(t.download.packages[platform])} />
                <div class="command">
                  <CodeBlock
                    code={PACKAGE_COMMANDS[platform].join("\n")}
                    copyLabel={`${t.download.copy}: ${PACKAGE_COMMANDS[platform].join("; ")}`}
                    copied={t.download.copied}
                  />
                </div>
              </>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <div class="container more">
    <p>
      <a href={release.checksumsUrl}><code>SHA256SUMS.txt</code></a>
      {t.download.checksums}
    </p>
    <p>{t.download.testing} <a href={`${REPO_URL}/issues`}>{t.download.issue}</a></p>
    <ul>
      <li><Link href={RELEASES_URL}>{t.download.allReleases}</Link></li>
      <li><Link href={BUILD_FROM_SOURCE_URL} hreflang="en">{t.download.source}</Link></li>
    </ul>
  </div>
</Base>

<style>
  :global(.head) {
    padding-top: var(--space-page-top);
  }

  .released {
    margin-top: var(--space-16);
    color: var(--on-night-2);
    font-size: var(--text-lg);
    font-variant-numeric: tabular-nums;
  }

  .released a {
    margin-left: var(--space-6);
  }

  /* The visitor's platform comes first. */
  .platforms {
    display: flex;
    flex-direction: column;
    padding: var(--space-24) 0;
  }

  :global(html[data-os="linux"]) #linux,
  :global(html[data-os="macos"]) #macos,
  :global(html[data-os="windows"]) #windows {
    order: -1;
  }

  .platform {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-24) var(--space-64);
    padding: var(--space-48) 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 16px;
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-12);
  }

  h2 {
    font-size: var(--text-h2);
  }

  .title :global(.this-device) {
    display: none;
  }

  :global(html[data-os="linux"]) #linux :global(.this-device),
  :global(html[data-os="macos"]) #macos :global(.this-device),
  :global(html[data-os="windows"]) #windows :global(.this-device) {
    display: inline-block;
  }

  .requirements {
    margin-top: var(--space-12);
    color: var(--ink-2);
  }

  .files {
    display: grid;
    gap: var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    margin-top: var(--space-32);
    font-size: var(--text-body);
  }

  .steps {
    margin-top: var(--space-8);
    max-width: 44em;
  }

  .command {
    margin-top: var(--space-12);
  }

  .more {
    display: grid;
    gap: var(--space-12);
    padding: var(--space-16) 0 var(--space-96);
    color: var(--ink-2);
  }

  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 800px) {
    .platform {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
