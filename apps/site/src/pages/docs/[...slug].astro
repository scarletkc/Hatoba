---
import { getCollection, render, type CollectionEntry } from "astro:content";
import CodeBlock from "../../components/CodeBlock.astro";
import Link from "../../components/Link.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Base from "../../layouts/Base.astro";
import { OVERVIEW, docPath, sidebar } from "../../lib/docs";
import { pageTitle } from "../../lib/seo";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { slug: doc.id === OVERVIEW ? undefined : doc.id }, props: { doc, docs } }));
}

const { doc, docs } = Astro.props as { doc: CollectionEntry<"docs">; docs: CollectionEntry<"docs">[] };
const { Content } = await render(doc);
const groups = sidebar(docs.map(({ id, data }) => ({ slug: id, title: data.title })));
const { title, description, editUrl, version } = doc.data;
const heading = doc.id === OVERVIEW ? "Hatoba documentation" : title;
---

<Base locale="en" title={pageTitle("en", doc.id === OVERVIEW ? "Documentation" : title)} description={description} path={docPath(doc.id)} translated={false}>
  <div class="container docs">
    <nav class="sidebar" aria-label="Documentation">
      <details open>
        <summary>Contents</summary>
        {
          groups.map((group) => (
            <div class="group">
              <p class="group-title">{group.title}</p>
              <ul>
                {group.pages.map((page) => (
                  <li>
                    <a href={docPath(page.slug)} aria-current={page.slug === doc.id ? "page" : undefined}>
                      {page.slug === OVERVIEW ? "Overview" : page.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </details>
    </nav>
    <article>
      <SectionHeader as="h1" size="title" title={heading}>
        <p class="version">{version ? `Describes Hatoba ${version}.` : "Describes the development version of Hatoba."}</p>
      </SectionHeader>
      <div class="prose">
        <Content />
      </div>
      <p class="edit">
        <Link href={editUrl} icon="external">Edit this page on GitHub</Link>
      </p>
    </article>
  </div>
  <!-- A <template> would keep the CodeBlock's script from running, so the source is a hidden div. -->
  <div id="code-block" hidden><CodeBlock code="" copyLabel="Copy" copied="Copied" /></div>
</Base>

<script>
  // Each code block gets the Copy button of a CodeBlock. It sits in the block's corner, so adding it
  // moves nothing.
  const copy = document.querySelector("#code-block button")!;
  for (const block of document.querySelectorAll(".prose .code-block")) block.append(copy.cloneNode(true));

  // On a narrow screen the contents start closed, so the page starts with the article.
  const contents = document.querySelector<HTMLDetailsElement>(".sidebar details");
  if (contents && matchMedia("(max-width: 900px)").matches) contents.open = false;
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    gap: var(--space-56);
    padding: var(--space-40) 0 var(--space-96);
  }

  .sidebar {
    position: sticky;
    top: 24px;
    align-self: start;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    font-size: var(--text-md);
  }

  summary {
    display: none;
  }

  .group + .group {
    margin-top: var(--space-24);
  }

  .group-title {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--ink);
    margin-bottom: var(--space-6);
  }

  .sidebar ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sidebar a {
    display: block;
    padding: var(--space-4) var(--space-10);
    margin-left: calc(-1 * var(--space-10));
    border-radius: var(--radius-md);
    color: var(--ink-2);
    text-decoration: none;
    line-height: 1.35;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .sidebar a:hover {
    color: var(--ink);
    background: var(--mist);
  }

  .sidebar a[aria-current="page"] {
    color: var(--link);
    background: var(--mist);
    font-weight: 600;
  }

  article {
    max-width: 46em;
  }

  .version {
    margin-top: var(--space-12);
    color: var(--ink-2);
    font-size: var(--text-md);
  }

  .edit {
    margin-top: var(--space-56);
    padding-top: var(--space-20);
    border-top: 1px solid var(--line);
    font-size: var(--text-md);
  }

  .prose {
    margin-top: var(--space-32);
  }

  .prose :global(h2) {
    margin: var(--space-48) 0 var(--space-12);
    font-size: var(--text-2xl);
  }

  .prose :global(h3) {
    margin: var(--space-32) 0 var(--space-8);
    font-size: var(--text-lg);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-16);
  }

  .prose :global(li + li) {
    margin-top: var(--space-6);
  }

  .prose :global(table) {
    width: 100%;
    margin: var(--space-8) 0 var(--space-24);
    border-collapse: collapse;
    font-size: var(--text-sm);
    display: block;
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-8) var(--space-12) var(--space-8) 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    font-weight: 600;
    color: var(--ink-2);
  }

  .prose :global(.code-block) {
    margin: 0 0 var(--space-16);
  }

  @media (max-width: 900px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
      padding-top: var(--space-24);
    }

    .sidebar {
      position: static;
      max-height: none;
      padding-bottom: var(--space-16);
      border-bottom: 1px solid var(--line);
    }

    summary {
      display: list-item;
      cursor: pointer;
      font-weight: 600;
      padding: var(--space-8) 0;
    }

    details[open] summary {
      margin-bottom: var(--space-12);
    }
  }
</style>
