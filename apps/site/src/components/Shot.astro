---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

/**
 * A screenshot, whole or cropped to a region given in its pixels. `width` is how wide it shows, as a
 * CSS length, so the browser can pick the right size of the image.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  width: string;
  crop?: { x: number; y: number; w: number; h: number };
  eager?: boolean;
  class?: string;
}

const { src, alt, width, crop, eager = false, class: className } = Astro.props;
const scale = crop ? src.width / crop.w : 1;
const percent = (value: number) => `${(value * 100).toFixed(4)}%`;
---

<div
  class:list={["shot", { cropped: crop }, className]}
  style={crop && {
    "aspect-ratio": `${crop.w} / ${crop.h}`,
    "--img-width": percent(scale),
    "--img-left": percent(-crop.x / crop.w),
    "--img-top": percent(-crop.y / crop.h),
  }}
>
  <Picture
    src={src}
    alt={alt}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={[720, 1080, 1440, 2160, src.width].filter((w) => w <= src.width)}
    sizes={`calc(${width} * ${scale.toFixed(3)})`}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
  />
</div>

<style>
  .shot :global(img) {
    width: 100%;
  }

  .cropped {
    position: relative;
    overflow: hidden;
  }

  .cropped :global(img) {
    position: absolute;
    width: var(--img-width);
    max-width: none;
    left: var(--img-left);
    top: var(--img-top);
  }
</style>
