---
import { BUG_REPORT_URL, CONTRIBUTING_URL, LICENSE_URL, RELEASES_URL, REPO_URL, SECURITY_URL } from "../consts";
import { LANG, LANGUAGE_NAME, LOCALES, localePath, messages, type Locale } from "../i18n";
import Link from "./Link.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages(locale);
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <p class="name wide">Hatoba</p>
      <p>{t.meta.tagline}</p>
      <p class="license"><Link variant="muted" href={LICENSE_URL}>{t.footer.license}</Link></p>
    </div>
    <ul class="links">
      <li><Link variant="muted" href={localePath(locale, "/download/")}>{t.nav.download}</Link></li>
      <li><Link variant="muted" href="/docs/" hreflang="en">{t.nav.docs}</Link></li>
      <li><Link variant="muted" href={RELEASES_URL}>{t.footer.releases}</Link></li>
      <li><Link variant="muted" href={REPO_URL}>{t.nav.github}</Link></li>
      <li><Link variant="muted" href={BUG_REPORT_URL}>{t.footer.report}</Link></li>
      <li><Link variant="muted" href={SECURITY_URL}>{t.footer.security}</Link></li>
      <li><Link variant="muted" href={CONTRIBUTING_URL}>{t.footer.contributing}</Link></li>
    </ul>
    <ul class="languages" aria-label={t.nav.language}>
      {
        LOCALES.map((other) => (
          <li>
            <Link
              variant="muted"
              href={localePath(other)}
              hreflang={LANG[other]}
              lang={LANG[other]}
              data-locale={other}
              aria-current={other === locale ? "true" : undefined}
            >
              {LANGUAGE_NAME[other]}
            </Link>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--night-deep);
    color: var(--on-night-2);
    font-size: var(--text-md);
    padding: var(--space-56) 0 var(--space-64);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr) auto;
    gap: var(--space-32) var(--space-48);
    align-items: start;
  }

  .name {
    color: var(--on-night);
    font-weight: 800;
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .license {
    margin-top: var(--space-16);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links {
    columns: 2;
    column-gap: var(--space-32);
  }

  .links li,
  .languages li {
    padding: var(--space-4) 0;
  }

  .languages :global(a[aria-current="true"]) {
    color: var(--on-night);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
