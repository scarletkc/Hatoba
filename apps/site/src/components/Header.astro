---
import { REPO_URL } from "../consts";
import { LANG, LANGUAGE_NAME, LOCALES, localePath, messages, type Locale } from "../i18n";
import Icon from "./Icon.astro";
import Sea from "./Sea.astro";

interface Props {
  locale: Locale;
  path: string;
  translated: boolean;
  /** Ends the night band with a strip of sea, for pages whose content starts on paper. */
  edge: boolean;
}

const { locale, path, translated, edge } = Astro.props;
const t = messages(locale);
const current = Astro.url.pathname;
const link = (target: string) => ({ href: target, "aria-current": current === target ? "page" : undefined });
---

<header class:list={["night", "site-header", { edge }]}>
  <nav class="container bar" aria-label="Hatoba">
    <a class="brand" href={localePath(locale)} aria-label={t.nav.home}>
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span class="wide">Hatoba</span>
    </a>
    <ul class="links">
      <li class="features"><a href={`${localePath(locale)}#features`}>{t.nav.features}</a></li>
      <li><a {...link(localePath(locale, "/download/"))}>{t.nav.download}</a></li>
      <li><a href="/docs/" aria-current={current.startsWith("/docs/") ? "page" : undefined} hreflang="en">{t.nav.docs}</a></li>
      <li>
        <a class="github" href={REPO_URL} aria-label={t.nav.github}><Icon name="github" size={20} /><span>{t.nav.github}</span></a>
      </li>
      <li>
        <details class="lang">
          <summary aria-label={`${t.nav.language}: ${LANGUAGE_NAME[locale]}`}><Icon name="globe" size={18} /><span>{LANGUAGE_NAME[locale]}</span></summary>
          <ul>
            {
              LOCALES.map((other) => (
                <li>
                  <a
                    href={localePath(other, translated ? path : "/")}
                    hreflang={LANG[other]}
                    data-locale={other}
                    lang={LANG[other]}
                    aria-current={other === locale ? "true" : undefined}
                  >
                    {LANGUAGE_NAME[other]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
    </ul>
  </nav>
  {edge && <Sea depth="var(--edge-depth)" class="header-sea" />}
</header>

<script>
  // Close the language menu when a click or Escape lands outside it.
  const menu = document.querySelector<HTMLDetailsElement>(".lang");
  document.addEventListener("click", (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 3;
    background: var(--night);
  }

  .site-header.edge {
    --edge-depth: 2px;
    padding-bottom: calc(var(--edge-depth) + var(--wave-height));
  }

  /* Above the strip of sea, which comes later in the header, so the language menu opens over it. */
  .bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    min-height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-10);
    text-decoration: none;
    font-weight: 800;
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }

  .brand img {
    border-radius: var(--radius-md);
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a,
  .lang summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 40px;
    padding: 0 var(--space-12);
    border-radius: var(--radius-full);
    color: var(--on-night);
    font-size: var(--text-md);
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover,
  .lang summary:hover {
    background: var(--on-night-hover);
  }

  .links a[aria-current="page"] {
    background: var(--on-night-current);
  }

  .lang {
    position: relative;
  }

  .lang summary {
    cursor: pointer;
    list-style: none;
    color: var(--on-night-2);
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang ul {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 160px;
    margin: 0;
    padding: var(--space-6);
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-popover);
  }

  .lang ul a {
    display: flex;
    width: 100%;
    color: var(--ink);
    border-radius: var(--radius-md);
  }

  .lang ul a:hover {
    background: var(--mist);
  }

  .lang ul a[aria-current="true"] {
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .features,
    .github span,
    .lang summary span {
      display: none;
    }

    .links a,
    .lang summary {
      padding: 0 var(--space-10);
    }
  }

  @media (max-width: 400px) {
    .brand span {
      display: none;
    }
  }
</style>
