---
import { REPO_URL } from "../consts";
import { LANG, LANGUAGE_NAME, LOCALES, localePath, messages, type Locale } from "../i18n";
import Button from "./Button.astro";
import NightBand from "./NightBand.astro";

interface Props {
  locale: Locale;
  path: string;
  translated: boolean;
  /** Ends the night band with a strip of sea, for pages whose content starts on paper. */
  edge: boolean;
}

const { locale, path, translated, edge } = Astro.props;
const t = messages(locale);
const current = Astro.url.pathname;
const download = localePath(locale, "/download/");
---

<NightBand as="header" class="site-header" sea={edge ? "2px" : undefined} room={false} flat>
  <nav class="container bar" aria-label="Hatoba">
    <a class="brand" href={localePath(locale)} aria-label={t.nav.home}>
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span class="wide">Hatoba</span>
    </a>
    <ul class="links">
      <li class="features"><Button variant="night" size="md" href={`${localePath(locale)}#features`}>{t.nav.features}</Button></li>
      <li><Button variant="night" size="md" href={download} aria-current={current === download ? "page" : undefined}>{t.nav.download}</Button></li>
      <li>
        <Button variant="night" size="md" href="/docs/" hreflang="en" aria-current={current.startsWith("/docs/") ? "page" : undefined}>{t.nav.docs}</Button>
      </li>
      <li>
        <Button variant="night" size="md" class="github" href={REPO_URL} icon="github" iconSize={20} aria-label={t.nav.github}><span>{t.nav.github}</span></Button>
      </li>
      <li>
        <details class="lang">
          <Button as="summary" variant="night" size="md" icon="globe" class="lang-button" aria-label={`${t.nav.language}: ${LANGUAGE_NAME[locale]}`}>
            <span>{LANGUAGE_NAME[locale]}</span>
          </Button>
          <ul class="menu">
            {
              LOCALES.map((other) => (
                <li>
                  <a
                    href={localePath(other, translated ? path : "/")}
                    hreflang={LANG[other]}
                    data-locale={other}
                    lang={LANG[other]}
                    aria-current={other === locale ? "true" : undefined}
                  >
                    {LANGUAGE_NAME[other]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
    </ul>
  </nav>
</NightBand>

<script>
  // Close the language menu when a click or Escape lands outside it.
  const menu = document.querySelector<HTMLDetailsElement>(".lang");
  document.addEventListener("click", (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>

<style>
  /* Over the page, so the language menu can open past the header's sea. */
  :global(.site-header.night) {
    z-index: 3;
    overflow: visible;
  }

  /* Above the strip of sea, which comes later in the header, so the language menu opens over it. */
  .bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    min-height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-10);
    text-decoration: none;
    font-weight: 800;
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }

  .brand img {
    border-radius: var(--radius-md);
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang {
    position: relative;
  }

  .lang :global(.lang-button) {
    color: var(--on-night-2);
  }

  .menu {
    --focus-ring: var(--focus-ring-paper);
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-6));
    min-width: 160px;
    margin: 0;
    padding: var(--space-6);
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-popover);
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  /* The menu fades in as it opens. */
  @starting-style {
    .menu {
      opacity: 0;
    }
  }

  .menu a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-12);
    border-radius: var(--radius-md);
    color: var(--ink);
    font-size: var(--text-md);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .menu a:hover {
    background: var(--mist);
  }

  .menu a:active {
    background: var(--line);
    transition-duration: var(--duration-instant);
  }

  .menu a[aria-current="true"] {
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .features,
    .links :global(.github span),
    .links :global(.lang-button span) {
      display: none;
    }

    .links :global(.button) {
      padding: 0 var(--space-10);
    }
  }

  @media (max-width: 400px) {
    .brand span {
      display: none;
    }
  }
</style>
