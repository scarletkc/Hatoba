---
import { localePath, messages, type Locale } from "../i18n";
import type { Platform, SiteRelease } from "../lib/release";
import Button from "./Button.astro";

interface Props {
  locale: Locale;
  release: SiteRelease;
  /** pier on the night band, accent on paper. */
  variant?: "pier" | "accent";
}

const { locale, release, variant = "pier" } = Astro.props;
const t = messages(locale);
const downloadPage = localePath(locale, "/download/");
/**
 * Windows downloads its installer at once. Linux has two packages and macOS needs the steps for an
 * unsigned app, so they go to their part of the download page.
 */
const targets: Record<Platform, string> = {
  windows: release.downloads.find((download) => download.platform === "windows")!.url,
  linux: `${downloadPage}#linux`,
  macos: `${downloadPage}#macos`,
};
const platforms = Object.keys(targets) as Platform[];
---

<!--
  Every label is in the page and the stylesheet shows the one for the platform the layout detected
  before the first paint, so the button never changes its width after the page shows. Phones and
  unknown systems get the download page.
-->
<Button
  variant={variant}
  icon="download"
  class="download"
  href={downloadPage}
  data-download
  {...Object.fromEntries(platforms.map((platform) => [`data-${platform}-href`, targets[platform]]))}
>
  <span class="for-all">{t.hero.allDownloads}</span>
  {platforms.map((platform) => <span class={`for-${platform}`}>{t.hero.downloadFor(t.platforms[platform])}</span>)}
</Button>

<script>
  const os = document.documentElement.dataset.os;
  if (os) {
    for (const button of document.querySelectorAll<HTMLAnchorElement>("a[data-download]")) {
      const href = button.dataset[`${os}Href`];
      if (href) button.href = href;
    }
  }
</script>

<style>
  :global(.download) > span {
    display: none;
  }

  :global(html:not([data-os]) .download) > .for-all,
  :global(html[data-os="windows"] .download) > .for-windows,
  :global(html[data-os="linux"] .download) > .for-linux,
  :global(html[data-os="macos"] .download) > .for-macos {
    display: inline;
  }
</style>
