---
import "@fontsource-variable/archivo/wdth.css";
import "../styles/tokens.css";
import "../styles/global.css";
import archivo from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_URL } from "../consts";
import { LANG, LOCALES, OG_LOCALE, localePath, messages, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  /** The full <title>. */
  title: string;
  description: string;
  /** The page's path without the locale prefix, starting and ending with a slash. */
  path: string;
  /** Whether the page exists in every locale, so it names the others as alternates. */
  translated?: boolean;
  /** Structured data (schema.org) for search engines. */
  jsonLd?: Record<string, unknown>;
  /** The header without its bottom edge, for a page whose first section continues the night band. */
  heroHeader?: boolean;
  /** Keeps the page out of search results, as the 404 page. */
  noindex?: boolean;
}

const { locale, title, description, path, translated = true, jsonLd, heroHeader = false, noindex = false } = Astro.props;
const t = messages(locale);
const url = new URL(localePath(locale, path), SITE_URL).href;
const image = new URL(localePath(translated ? locale : "en", "/og.png"), SITE_URL).href;

/**
 * Sends a visitor whose browser prefers Chinese or Japanese from an English page to the same page in
 * that language, until they pick a language in a menu (LOCALE_KEY). It runs first in <head>, so the
 * English page doesn't show before the other one; crawlers ask for English, and hreflang links the
 * languages for them.
 */
const LOCALE_KEY = "hatoba.locale";
const paths = JSON.stringify({ zh: localePath("zh", path), ja: localePath("ja", path) });
const redirect =
  locale === "en" && translated
    ? `try {
        if (!localStorage.getItem("${LOCALE_KEY}")) {
          const paths = ${paths};
          for (const language of navigator.languages || [navigator.language]) {
            const tag = language.toLowerCase();
            if (tag.startsWith("en")) break;
            const target = tag.startsWith("zh") ? paths.zh : tag.startsWith("ja") ? paths.ja : "";
            if (target) {
              location.replace(target + location.search + location.hash);
              break;
            }
          }
        }
      } catch {
        // Without storage a choice of English could not be kept, so stay.
      }`
    : null;
---

<!doctype html>
<html lang={LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    {redirect && <script is:inline set:html={redirect} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    {
      translated && [
        ...LOCALES.map((other) => <link rel="alternate" hreflang={LANG[other]} href={new URL(localePath(other, path), SITE_URL).href} />),
        <link rel="alternate" hreflang="x-default" href={new URL(path, SITE_URL).href} />,
      ]
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hatoba" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.hero.alt} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {translated && LOCALES.filter((other) => other !== locale).map((other) => <meta property="og:locale:alternate" content={OG_LOCALE[other]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d1735" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // The visitor's platform, which the download buttons and the download page offer first.
      (() => {
        const ua = navigator.userAgent.toLowerCase();
        if (/android|iphone|ipad|ipod/.test(ua)) return;
        const platform = (navigator.userAgentData?.platform || navigator.platform || ua).toLowerCase();
        // iPadOS reports itself as a Mac, but a Mac has no touch screen.
        if (/mac/.test(platform) && navigator.maxTouchPoints > 1) return;
        const os = /win/.test(platform) ? "windows" : /mac/.test(platform) ? "macos" : /linux|x11|cros/.test(platform) ? "linux" : "";
        if (os) document.documentElement.dataset.os = os;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header locale={locale} path={path} translated={translated} edge={!heroHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline set:html={`document.addEventListener("click", (event) => {
      // A language picked in a menu stops the redirect above.
      const link = event.target instanceof Element && event.target.closest("a[data-locale]");
      if (!link) return;
      try {
        localStorage.setItem("${LOCALE_KEY}", link.dataset.locale);
      } catch {}
    });`} />
  </body>
</html>
