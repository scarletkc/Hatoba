{
  "name": "hatoba",
  "private": true,
  "version": "0.7.4",
  "description": "Open-source desktop SSH client with an AI assistant and end-to-end encrypted sync through your own Cloudflare account",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter @hatoba/desktop dev",
    "tauri": "pnpm --filter @hatoba/desktop tauri",
    "build": "pnpm --filter @hatoba/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "worker:bundle": "node scripts/worker/bundle.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1"
  }
}
